partwhole:properPartOf rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://isotc204.org/25965/transport/transportnetwork#capacity
transportnetwork:capacity rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:nonNegativeInteger .


###  https://isotc204.org/25965/transport/transportnetwork#designator
transportnetwork:designator rdf:type owl:DatatypeProperty ;
                            rdfs:range xsd:string .


###  https://isotc204.org/25965/transport/transportnetwork#headline
transportnetwork:headline rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:string .


###  https://isotc204.org/25965/transport/transportnetwork#issuer
transportnetwork:issuer rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:nonNegativeInteger .


###  https://isotc204.org/25965/transport/transportnetwork#maxLanes
transportnetwork:maxLanes rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:nonNegativeInteger .


###  https://isotc204.org/25965/transport/transportnetwork#numLanes
transportnetwork:numLanes rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:nonNegativeInteger .


###  https://isotc204.org/25965/transport/transportnetwork#resources
transportnetwork:resources rdf:type owl:DatatypeProperty .


###  https://isotc204.org/25965/transport/transportnetwork#website
transportnetwork:website rdf:type owl:DatatypeProperty ;
                         rdfs:range xsd:anyURI .


###  https://isotc204.org/25965/transport/transportnetwork#width
transportnetwork:width rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:nonNegativeInteger .


###  https://isotc204.org/25965/transport/transportnetwork#genProp:hasDescription
transportnetwork:genProp:hasDescription rdf:type owl:DatatypeProperty ;
                                        rdfs:range xsd:string .


###  https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/GenericProperties#hasIdentifier
genProp:hasIdentifier rdf:type owl:DatatypeProperty ;
                      rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  https://isotc204.org/25965/transport/transportnetwork#Alert
transportnetwork:Alert rdf:type owl:Class ;
                       rdfs:subClassOf transportnetwork:ITSThing ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:activities ;
                                         owl:allValuesFrom activity:Activity
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:beginTime ;
                                         owl:allValuesFrom time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:category ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:cause ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:certainty ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:creationTime ;
                                         owl:allValuesFrom time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:distribution ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:effect ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:endTime ;
                                         owl:allValuesFrom time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:expiryTime ;
                                         owl:allValuesFrom time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:lastUpdateTime ;
                                         owl:allValuesFrom time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:location ;
                                         owl:allValuesFrom geo:Geometry
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:recommendation ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:referencedAlert ;
                                         owl:allValuesFrom transportnetwork:Alert
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:resources ;
                                         owl:allValuesFrom transportnetwork:URI
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:severity ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:status ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:urgency ;
                                         owl:allValuesFrom code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:category ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:creationTime ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:distribution ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:expiryTime ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:lastUpdateTime ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:status ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:beginTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:certainty ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:endTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass time:Instant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:severity ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:urgency ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass code:Code
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:headline ;
                                         owl:allValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:issuer ;
                                         owl:allValuesFrom xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:website ;
                                         owl:allValuesFrom xsd:anyURI
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/GenericProperties/hasDescription> ;
                                         owl:allValuesFrom xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:headline ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:issuer ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:website ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:anyURI
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty transportnetwork:genProp:hasDescription ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] .


###  https://isotc204.org/25965/transport/transportnetwork#Footpath
transportnetwork:Footpath rdf:type owl:Class ;
                          rdfs:subClassOf transportnetwork:TravelledWay ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty partwhole:hasProperPart ;
                                            owl:allValuesFrom transportnetwork:FootpathLink
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty partwhole:properPartOf ;
                                            owl:allValuesFrom transportnetwork:FootpathNetwork
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty partwhole:hasProperPart ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass transportnetwork:FootpathLink
                                          ] .


###  https://isotc204.org/25965/transport/transportnetwork#FootpathLane
transportnetwork:FootpathLane rdf:type owl:Class ;
                              rdfs:subClassOf transportnetwork:TravelledWayLane ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:properPartOf ;
                                                owl:allValuesFrom transportnetwork:FootpathSegment
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:properPartOf ;
                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass transportnetwork:FootpathSegment
                                              ] .


###  https://isotc204.org/25965/transport/transportnetwork#FootpathLink
transportnetwork:FootpathLink rdf:type owl:Class ;
                              rdfs:subClassOf transportnetwork:TravelledWayLink ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:hasProperPart ;
                                                owl:allValuesFrom transportnetwork:FootpathSegment
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:properPartOf ;
                                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                                    owl:unionOf ( transportnetwork:Footpath
                                                                                  transportnetwork:FootpathNetwork
                                                                                  transportnetwork:FootpathSection
                                                                                )
                                                                  ]
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:hasProperPart ;
                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass transportnetwork:FootpathSegment
                                              ] .


###  https://isotc204.org/25965/transport/transportnetwork#FootpathNetwork
transportnetwork:FootpathNetwork rdf:type owl:Class ;
                                 rdfs:subClassOf transportnetwork:TransportNetwork ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:hasProperPart ;
                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                       owl:unionOf ( transportnetwork:Footpath
                                                                                     transportnetwork:FootpathLink
                                                                                     transportnetwork:FootpathSection
                                                                                   )
                                                                     ]
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:hasProperPart ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass transportnetwork:FootpathLink
                                                 ] .


###  https://isotc204.org/25965/transport/transportnetwork#FootpathSection
transportnetwork:FootpathSection rdf:type owl:Class ;
                                 rdfs:subClassOf transportnetwork:TravelledWaySection ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:hasProperPart ;
                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                       owl:unionOf ( transportnetwork:FootpathLink
                                                                                     transportnetwork:FootpathSegment
                                                                                   )
                                                                     ]
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:properPartOf ;
                                                   owl:allValuesFrom transportnetwork:FootpathNetwork
                                                 ] .


###  https://isotc204.org/25965/transport/transportnetwork#FootpathSegment
transportnetwork:FootpathSegment rdf:type owl:Class ;
                                 rdfs:subClassOf transportnetwork:TravelledWaySegment ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:hasProperPart ;
                                                   owl:allValuesFrom transportnetwork:FootpathLane
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:properPartOf ;
                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                       owl:unionOf ( transportnetwork:FootpathLink
                                                                                     transportnetwork:FootpathSection
                                                                                   )
                                                                     ]
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:hasProperPart ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass transportnetwork:FootpathLane
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty partwhole:properPartOf ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass transportnetwork:FootpathLink
                                                 ] .


###  https://isotc204.org/25965/transport/transportnetwork#GroupOfLines
transportnetwork:GroupOfLines rdf:type owl:Class ;
                              rdfs:subClassOf transportnetwork:ITSThing ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:hasProperPart ;
                                                owl:allValuesFrom transportnetwork:Line
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:properPartOf ;
                                                owl:allValuesFrom transportnetwork:PublicTransportSystem
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty partwhole:hasProperPart ;
                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass transportnetwork:Line
                                              ] .


###  https://isotc204.org/25965/transport/transportnetwork#ITSThing
transportnetwork:ITSThing rdf:type owl:Class .


###  https://isotc204.org/25965/transport/transportnetwork#Junction
transportnetwork:Junction rdf:type owl:Class ;
                          rdfs:subClassOf transportnetwork:TransportNode .


###  https://isotc204.org/25965/transport/transportnetwork#Line
transportnetwork:Line rdf:type owl:Class ;
                      rdfs:subClassOf transportnetwork:ITSThing ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty transportnetwork:allowedDirections ;
                                        owl:allValuesFrom code:Code
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty partwhole:hasProperPart ;
                                        owl:allValuesFrom transportnetwork:Route
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty partwhole:properPartOf ;
                                        owl:allValuesFrom [ rdf:type owl:Class ;
                                                            owl:unionOf ( transportnetwork:GroupOfLines
                                                                          transportnetwork:PublicTransportSystem
                                                                        )
                                                          ]
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty transportnetwork:allowedDirections ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass code:Code
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty partwhole:hasProperPart ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass transportnetwork:Route
                                      ] .


###  https://isotc204.org/25965/transport/transportnetwork#MicromobilityLane
transportnetwork:MicromobilityLane rdf:type owl:Class ;
                                   rdfs:subClassOf transportnetwork:RoadLane ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty partwhole:properPartOf ;
                                                     owl:allValuesFrom transportnetwork:MicromobilityPathSegment
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty partwhole:properPartOf ;
                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass transportnetwork:MicromobilityPathSegment
                                                   ] .


###  https://isotc204.org/25965/transport/transportnetwork#MicromobilityLink
transportnetwork:MicromobilityLink rdf:type owl:Class ;
                                   rdfs:subClassOf transportnetwork:RoadLink ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty partwhole:hasProperPart ;
                                                     owl:allValuesFrom transportnetwork:MicromobilityPathSegment
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty partwhole:properPartOf ;
                                                     owl:allValuesFrom [ rdf:type owl:Class ;
                                                                         owl:unionOf ( transportnetwork:MicromobilityNetwork
                                                                                       transportnetwork:MicromobilityPath
                                                                                       transportnetwork:MicromobilityPathSection
                                                                                     )
                                                                       ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
