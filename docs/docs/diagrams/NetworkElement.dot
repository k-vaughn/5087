// Diagram for NetworkElement
digraph {
	graph [overlap=false splines=true]
	node [fontname=Arial fontsize=12 shape=record]
	edge [fontname=Arial fontsize=10]
	subgraph cluster_main {
		rankdir=TB style=invis
		ITSThing [label=ITSThing]
		{
			rank=max
			NetworkElement [label="{NetworkElement|genProp:hasIdentifier: string [1]}"]
		}
		NetworkElement -> ITSThing [arrowhead=onormal style=solid]
	}
	NetworkElement:e -> NetworkElement [label="partwhole:hasProperPart" headlabel="" style=solid]
	NetworkElement:s -> Status [label=status arrowhead=normal headlabel="" style=solid]
	NetworkElement:e -> NetworkElement [label="partwhole:properPartOf" headlabel="" style=solid]
	subgraph cluster_others {
		style=invis
		NetworkElement [label=NetworkElement]
		Status [label=Status]
	}
}
