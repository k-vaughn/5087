Class: activity:Activity

    
Class: cityunits:Duration

    
Class: code:Code

    
Class: geo:Feature

    
Class: geo:Geometry

    
Class: time:DateTimeInterval

    
Class: time:Instant

    
Class: transinfras:Road

    
Class: transinfras:RoadLink

    
Class: transinfras:RoadSegment

    
Class: transinfras:TravelledWay

    
Class: transinfras:TravelledWayLink

    
Class: transinfras:TravelledWaySegment

    
Class: transportnetwork:Alert

    SubClassOf: 
        transportnetwork:ITSThing,
        transportnetwork:activities only activity:Activity,
        transportnetwork:cause only code:Code,
        transportnetwork:effect only code:Code,
        transportnetwork:location only geo:Geometry,
        transportnetwork:recommendation only code:Code,
        transportnetwork:referencedAlert only transportnetwork:Alert,
        transportnetwork:resources only transportnetwork:URI,
        transportnetwork:category exactly 1 code:Code,
        transportnetwork:creationTime exactly 1 time:Instant,
        transportnetwork:distribution exactly 1 code:Code,
        transportnetwork:expiryTime exactly 1 time:Instant,
        transportnetwork:lastUpdateTime exactly 1 time:Instant,
        transportnetwork:status exactly 1 code:Code,
        transportnetwork:beginTime max 1 time:Instant,
        transportnetwork:certainty max 1 code:Code,
        transportnetwork:endTime max 1 time:Instant,
        transportnetwork:severity max 1 code:Code,
        transportnetwork:urgency max 1 code:Code,
        transportnetwork:headline exactly 1 xsd:string,
        transportnetwork:issuer exactly 1 xsd:nonNegativeInteger,
        transportnetwork:website exactly 1 xsd:anyURI,
        transportnetwork:genProp:hasDescription exactly 1 xsd:string
    
    
Class: transportnetwork:GroupOfLines

    SubClassOf: 
        transportnetwork:ITSThing
    
    
Class: transportnetwork:ITSThing

    
Class: transportnetwork:Junction

    SubClassOf: 
        transportnetwork:TransportNode
    
    
Class: transportnetwork:Line

    SubClassOf: 
        transportnetwork:ITSThing
    
    
Class: transportnetwork:MicromobilityLane

    SubClassOf: 
        transportnetwork:RoadLane,
        partwhole:properPartOf min 1 transportnetwork:MicromobilityPathSegment
    
    
Class: transportnetwork:MicromobilityLink

    SubClassOf: 
        transportnetwork:RoadLink,
        partwhole:properPartOf only 
            (transportnetwork:MicromobilityNetwork or transportnetwork:MicromobilityPath or transportnetwork:MicromobilityPathSection or transportnetwork:MicromobilityPathSegment),
        partwhole:hasProperPart min 1 transportnetwork:MicromobilityPathSegment
    
    
Class: transportnetwork:MicromobilityNetwork

    SubClassOf: 
        transportnetwork:RoadNetwork,
        partwhole:hasProperPart only 
            (transportnetwork:MicromobilityLink or transportnetwork:MicromobilityPath or transportnetwork:MicromobilityPathSection),
        partwhole:hasProperPart min 1 transportnetwork:MicromobilityLink
    
    
Class: transportnetwork:MicromobilityPath

    SubClassOf: 
        transportnetwork:Road,
        partwhole:properPartOf only transportnetwork:MicromobilityNetwork
    
    
Class: transportnetwork:MicromobilityPathSection

    SubClassOf: 
        transportnetwork:RoadSection,
        partwhole:hasProperPart only 
            (transportnetwork:MicromobilityLink or transportnetwork:MicromobilityPathSegment),
        partwhole:properPartOf only transportnetwork:MicromobilityNetwork
    
    
Class: transportnetwork:MicromobilityPathSegment

    SubClassOf: 
        transportnetwork:RoadSegment,
        partwhole:properPartOf only 
            (transportnetwork:MicromobilityLink or transportnetwork:MicromobilityPathSection),
        partwhole:hasProperPart min 1 transportnetwork:MicromobilityLane,
        partwhole:properPartOf min 1 transportnetwork:MicromobilityLink
    
    
Class: transportnetwork:NetworkElement

    SubClassOf: 
        transportnetwork:ITSThing,
        geo:Feature,
        transportnetwork:status only transportnetwork:Status,
        partwhole:hasProperPart only transportnetwork:NetworkElement,
        partwhole:properPartOf only transportnetwork:NetworkElement,
        genProp:hasIdentifier only xsd:string,
        genProp:hasIdentifier exactly 1 xsd:string
    
    
Class: transportnetwork:PublicTransportSystem

    SubClassOf: 
        transportnetwork:ITSThing,
        partwhole:hasProperPart only 
            (transportnetwork:GroupOfLines or transportnetwork:Line)
    
    
Class: transportnetwork:RailCorridor

    SubClassOf: 
        transportnetwork:TravelledWay,
        partwhole:properPartOf only transportnetwork:RailNetwork,
        partwhole:hasProperPart min 1 transportnetwork:TrackLink
    
    
Class: transportnetwork:RailNetwork

    SubClassOf: 
        transportnetwork:TransportNetwork,
        partwhole:hasProperPart only 
            (transportnetwork:RailCorridor or transportnetwork:RailSection or transportnetwork:TrackLink),
        partwhole:hasProperPart min 1 transportnetwork:TrackLink
    
    
Class: transportnetwork:RailSection

    SubClassOf: 
        transportnetwork:TravelledWaySection,
        partwhole:hasProperPart only 
            (transportnetwork:TrackLink or transportnetwork:TrackSegment),
        partwhole:properPartOf only transportnetwork:RailNetwork
    
    
Class: transportnetwork:Road

    SubClassOf: 
        transportnetwork:TravelledWay,
        transinfras:Road,
        partwhole:properPartOf only transportnetwork:RoadNetwork,
        partwhole:hasProperPart min 1 transportnetwork:RoadLink
    
    
Class: transportnetwork:RoadLane

    SubClassOf: 
        transportnetwork:TravelledWayLane,
        transportnetwork:next only transportnetwork:RoadLane,
        transportnetwork:previous only transportnetwork:RoadLane,
        partwhole:properPartOf min 1 transportnetwork:RoadSegment,
        transportnetwork:width exactly 1 xsd:nonNegativeInteger
    
    
Class: transportnetwork:RoadLink

    SubClassOf: 
        transportnetwork:TravelledWayLink,
        transinfras:RoadLink,
        transportnetwork:usedBy only transportnetwork:RoadLinkUser,
        partwhole:hasProperPart only transportnetwork:RoadSegment,
        partwhole:properPartOf only 
            (transportnetwork:Road or transportnetwork:RoadNetwork or transportnetwork:RoadSection),
        transportnetwork:primaryUser max 1 transportnetwork:RoadLinkUser,
        transportnetwork:travelTime max 1 cityunits:Duration,
        transportnetwork:capacity exactly 1 xsd:nonNegativeInteger,
        transportnetwork:maxLanes exactly 1 xsd:nonNegativeInteger
    
    
Class: transportnetwork:RoadLinkUser

    SubClassOf: 
        transportnetwork:ITSThing,
        transportnetwork:uses min 1 transportnetwork:RoadLink,
        transportnetwork:userCategory exactly 1 code:Code
    
    
Class: transportnetwork:RoadNetwork

    SubClassOf: 
        transportnetwork:TransportNetwork,
        partwhole:hasProperPart only 
            (transportnetwork:Road or transportnetwork:RoadLink or transportnetwork:RoadSection),
        partwhole:hasProperPart min 1 transportnetwork:RoadLink
    
    
Class: transportnetwork:RoadSection

    SubClassOf: 
        transportnetwork:TravelledWaySection,
        partwhole:hasProperPart only 
            (transportnetwork:RoadLink or transportnetwork:RoadSegment),
        partwhole:properPartOf only transportnetwork:RoadNetwork
    
    
Class: transportnetwork:RoadSegment

    SubClassOf: 
        transportnetwork:TravelledWaySegment,
        transinfras:RoadSegment,
        partwhole:properPartOf only 
            (transportnetwork:RoadLink or transportnetwork:RoadSection),
        partwhole:hasProperPart min 1 transportnetwork:RoadLane,
        partwhole:properPartOf exactly 1 transportnetwork:RoadLink,
        transportnetwork:pavementType max 1 code:Code,
        transportnetwork:numLanes exactly 1 xsd:nonNegativeInteger,
        transportnetwork:width exactly 1 xsd:nonNegativeInteger
    
    
Class: transportnetwork:Route

    SubClassOf: 
        transportnetwork:ITSThing,
        transportnetwork:direction min 1 code:Code
    
    
Class: transportnetwork:Status

    SubClassOf: 
        transportnetwork:ITSThing,
        transportnetwork:code only code:Code,
        transportnetwork:timeInterval exactly 1 time:DateTimeInterval
    
    
Class: transportnetwork:TrackLink

    SubClassOf: 
        transportnetwork:TravelledWayLink,
        partwhole:hasProperPart only transportnetwork:TrackSegment,
        partwhole:properPartOf only 
            (transportnetwork:RailCorridor or transportnetwork:RailNetwork or transportnetwork:RailSection)
    
    
Class: transportnetwork:TrackSegment

    SubClassOf: 
        transportnetwork:TravelledWaySegment,
        partwhole:properPartOf only 
            (transportnetwork:RailSection or transportnetwork:TrackLink),
        partwhole:properPartOf min 1 transportnetwork:TrackLink
    
    
Class: transportnetwork:TransportAlert

    SubClassOf: 
        transportnetwork:Alert,
        transportnetwork:affects only transportnetwork:NetworkElement
    
    
Class: transportnetwork:TransportNetwork

    SubClassOf: 
        transportnetwork:NetworkElement,
        partwhole:hasProperPart only 
            (transportnetwork:TransportNetwork or transportnetwork:TransportNode or transportnetwork:TravelledWay or transportnetwork:TravelledWayLink or transportnetwork:TravelledWaySection)
    
    
Class: transportnetwork:TransportNode

    SubClassOf: 
        transportnetwork:NetworkElement,
        transportnetwork:egress min 1 transportnetwork:TravelledWayLink,
        transportnetwork:ingress min 1 transportnetwork:TravelledWayLink,
        partwhole:properPartOf min 1 transportnetwork:TransportNetwork
    
    
Class: transportnetwork:TravelCorridor

    SubClassOf: 
        transportnetwork:TravelledWay,
        partwhole:hasProperPart min 1 transportnetwork:TravelCorridorLink
    
    
Class: transportnetwork:TravelCorridorLink

    SubClassOf: 
        transportnetwork:TravelledWayLink,
        partwhole:properPartOf only transportnetwork:TravelCorridor,
        partwhole:hasProperPart min 1 transportnetwork:TravelCorridorSegment
    
    
Class: transportnetwork:TravelCorridorSegment

    SubClassOf: 
        transportnetwork:TravelledWaySegment,
        partwhole:properPartOf only transportnetwork:TravelCorridorLink,
        transportnetwork:corridorElement min 1 transportnetwork:TravelledWaySegment
    
    
Class: transportnetwork:TravelledWay

    SubClassOf: 
        transportnetwork:NetworkElement,
        transinfras:TravelledWay,
        partwhole:hasProperPart only transportnetwork:TravelledWayLink,
        partwhole:properPartOf min 1 transportnetwork:TransportNetwork,
        transportnetwork:designator exactly 1 xsd:string
    
    
Class: transportnetwork:TravelledWayLane

    SubClassOf: 
        transportnetwork:NetworkElement,
        partwhole:properPartOf min 1 transportnetwork:TravelledWaySegment
    
    
Class: transportnetwork:TravelledWayLink

    SubClassOf: 
        transportnetwork:NetworkElement,
        transinfras:TravelledWayLink,
        partwhole:hasProperPart only transportnetwork:TravelledWaySegment,
        partwhole:properPartOf only 
            (transportnetwork:TransportNetwork or transportnetwork:TravelledWay or transportnetwork:TravelledWaySection),
        partwhole:properPartOf min 1 transportnetwork:TransportNetwork,
        transportnetwork:from exactly 1 transportnetwork:TransportNode,
        transportnetwork:to exactly 1 transportnetwork:TransportNode,
        transportnetwork:allowedDirections max 1 code:Code
    
    
Class: transportnetwork:TravelledWaySection

    SubClassOf: 
        transportnetwork:NetworkElement,
        partwhole:hasProperPart only 
            (transportnetwork:TravelledWayLink or transportnetwork:TravelledWaySegment),
        partwhole:properPartOf min 1 transportnetwork:TransportNetwork
    
    
Class: transportnetwork:TravelledWaySegment

    SubClassOf: 
        transportnetwork:NetworkElement,
        transinfras:TravelledWaySegment,
        transportnetwork:travelCorridorSegment only transportnetwork:TravelCorridorSegment,
        partwhole:properPartOf only 
            (transportnetwork:TravelledWayLink or transportnetwork:TravelledWaySection),
        partwhole:hasProperPart min 1 transportnetwork:TravelledWayLane,
        partwhole:properPartOf min 1 transportnetwork:TravelledWayLink
    
    
Class: transportnetwork:URI

    
