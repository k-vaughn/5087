    <!-- https://isotc204.org/25965/transport/transportnetwork#Alert -->

    <owl:Class rdf:about="https://isotc204.org/25965/transport/transportnetwork#Alert">
        <rdfs:subClassOf rdf:resource="https://isotc204.org/25965/transport/transportnetwork#ITSThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://isotc204.org/25965/transport/transportnetwork#activities"/>
                <owl:allValuesFrom rdf:resource="https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/activity#Activity"/>
