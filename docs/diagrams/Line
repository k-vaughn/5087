// Diagram for Line
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=10]
	ITSThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>ITSThing</B></TD></TR></TABLE>> margin=0]
	{
		rank=max
		Line [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER" PORT="e"><B>Line</B></TD></TR></TABLE>> margin=0]
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		GroupOfLines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>GroupOfLines</B></TD></TR></TABLE>> margin=0]
		PublicTransportSystem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>PublicTransportSystem</B></TD></TR></TABLE>> margin=0]
		Route [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>Route</B></TD></TR></TABLE>> margin=0]
		code_Code [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>code:Code</B></TD></TR></TABLE>> margin=0]
	}
	Line -> ITSThing [arrowhead=onormal style=solid]
	Line -> Invis [style=invis]
	Invis -> GroupOfLines [style=invis]
	GroupOfLines -> PublicTransportSystem [style=invis]
	PublicTransportSystem -> Route [style=invis]
	Route -> code_Code [style=invis]
	Line -> code_Code [label="«min 1, only»\nonProperty: allowedDirections" arrowhead=normal style=solid]
	Line -> Route [label="«min 1, only»\nonProperty: partwhole:hasProperPart" arrowhead=normal style=solid]
	Union_partwhole_properPartOf [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="lightyellow"><TR><TD ALIGN="CENTER">«unionOf»<BR/>[GroupOfLines or PublicTransportSystem]</TD></TR></TABLE>> margin=0]
	Union_partwhole_properPartOf -> GroupOfLines [label=member arrowhead=normal style=dotted]
	Union_partwhole_properPartOf -> PublicTransportSystem [label=member arrowhead=normal style=dotted]
	Line -> Union_partwhole_properPartOf [label="«only»\nonProperty: partwhole:properPartOf" arrowhead=normal style=solid]
}
