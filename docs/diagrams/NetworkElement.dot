// Diagram for NetworkElement
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=10]
	ITSThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>ITSThing</B></TD></TR></TABLE>> margin=0]
	geo_Feature [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>geo:Feature</B></TD></TR></TABLE>> margin=0]
	{
		rank=max
		NetworkElement [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER" PORT="e"><B><I>NetworkElement</I></B></TD></TR><TR><TD ALIGN="LEFT">genProp:hasIdentifier: string «exactly 1, only»</TD></TR></TABLE>> margin=0]
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		Status [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>Status</B></TD></TR></TABLE>> margin=0]
	}
	NetworkElement -> ITSThing [arrowhead=onormal style=solid]
	NetworkElement -> geo_Feature [arrowhead=onormal style=solid]
	NetworkElement -> Invis [style=invis]
	Invis -> Status [style=invis]
	NetworkElement -> Status [label="«only»\nonProperty: status" arrowhead=normal style=solid]
	NetworkElement -> NetworkElement [label="«only»\nonProperty: partwhole:hasProperPart" style=solid]
	NetworkElement -> NetworkElement [label="«only»\nonProperty: partwhole:properPartOf" style=solid]
}
