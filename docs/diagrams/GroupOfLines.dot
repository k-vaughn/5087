// Diagram for GroupOfLines
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=10]
	ITSThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>ITSThing</B></TD></TR></TABLE>> margin=0]
	{
		rank=max
		GroupOfLines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER" PORT="e"><B>GroupOfLines</B></TD></TR></TABLE>> margin=0]
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		Line [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>Line</B></TD></TR></TABLE>> margin=0]
		PublicTransportSystem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>PublicTransportSystem</B></TD></TR></TABLE>> margin=0]
	}
	GroupOfLines -> ITSThing [arrowhead=onormal style=solid]
	GroupOfLines -> Invis [style=invis]
	Invis -> Line [style=invis]
	Line -> PublicTransportSystem [style=invis]
	GroupOfLines -> Line [label="«min 1, only»\nonProperty: partwhole:hasProperPart" arrowhead=normal style=solid]
	GroupOfLines -> PublicTransportSystem [label="«only»\nonProperty: partwhole:properPartOf" arrowhead=normal style=solid]
}
