// Diagram for PublicTransportRoute
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=10]
	ITSThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>ITSThing</B></TD></TR></TABLE>> margin=0]
	{
		rank=max
		PublicTransportRoute [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER" PORT="e"><B>PublicTransportRoute</B></TD></TR></TABLE>> margin=0]
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		PublicTransportLine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>PublicTransportLine</B></TD></TR></TABLE>> margin=0]
		code_Code [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>code:Code</B></TD></TR></TABLE>> margin=0]
	}
	PublicTransportRoute -> ITSThing [arrowhead=onormal style=solid]
	PublicTransportRoute -> Invis [style=invis]
	Invis -> PublicTransportLine [style=invis]
	PublicTransportLine -> code_Code [style=invis]
	PublicTransportRoute -> code_Code [label="«min 1, only»\nonProperty: direction" arrowhead=normal style=solid]
	PublicTransportRoute -> PublicTransportLine [label="«min 1, only»\nonProperty: partwhole:properPartOf" arrowhead=normal style=solid]
}
