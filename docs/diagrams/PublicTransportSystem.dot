// Diagram for PublicTransportSystem
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=10]
	ITSThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>ITSThing</B></TD></TR></TABLE>> margin=0]
	{
		rank=max
		PublicTransportSystem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER" PORT="e"><B>PublicTransportSystem</B></TD></TR></TABLE>> margin=0]
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		GroupOfLines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>GroupOfLines</B></TD></TR></TABLE>> margin=0]
		Line [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER"><B>Line</B></TD></TR></TABLE>> margin=0]
	}
	PublicTransportSystem -> ITSThing [arrowhead=onormal style=solid]
	PublicTransportSystem -> Invis [style=invis]
	Invis -> GroupOfLines [style=invis]
	GroupOfLines -> Line [style=invis]
	Union_partwhole_hasProperPart [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="lightyellow"><TR><TD ALIGN="CENTER">«unionOf»<BR/>[GroupOfLines or Line]</TD></TR></TABLE>> margin=0]
	Union_partwhole_hasProperPart -> GroupOfLines [label=member arrowhead=normal style=dotted]
	Union_partwhole_hasProperPart -> Line [label=member arrowhead=normal style=dotted]
	PublicTransportSystem -> Union_partwhole_hasProperPart [label="«only»\nonProperty: partwhole:hasProperPart" arrowhead=normal style=solid]
}
